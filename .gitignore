# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch models and checkpoints
models/
*.pth
*.pt

# Results, logs and figures
results/
logs/
*.png
*.pdf

# Virtual environments
venv/
env/
.venv/

# IDEs
.vscode/
.idea/

# Note: Datasets are intentionally left out of this gitignore 
# because you mentioned you want to push the data. 
